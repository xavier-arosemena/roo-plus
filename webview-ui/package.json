	"devDependencies": {
		"@playwright/experimental-ct-react": "1.62.1",
		"@playwright/test": "1.62.1",
		"@roo-code/config-eslint": "workspace:^",
		"@roo-code/config-typescript": "workspace:^",
		"@testing-library/jest-dom": "6.9.1",
