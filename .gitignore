.pnpm-store
dist
out
out-*
node_modules
package-lock.json
coverage/
mock/

.DS_Store

# IDEs
.idea

# Builds
bin/
*.vsix

# Bundled DCG release archives (DCG 3a, 2026-10-21). These are distribution
# inputs, not build output: they MUST be committed, otherwise a fresh clone
# packages a VSIX without the guard. See docs/DCG-RELEASE-GOVERNANCE.md.
!src/bin/
!src/bin/dcg/

# Local prompts and rules
/local-prompts
AGENTS.local.md

# Test environment
.test_env
.vscode-test/

# Internal roadmap
internal-docs/

# Dotenv
.env
.env.*
!.env.*.sample

# Logging
logs
*.log

# Vite development
.vite-port

# Turborepo
.turbo

# IntelliJ and Qodo plugin folders
.idea/
.qodo/
.vercel
.roo/mcp.json

# Qdrant
qdrant_storage/

# Architect plans
plans/

roo-cli-*.tar.gz*
.worktrees/

# Experiment run artefacts. results.jsonl carries the full reply text and is the
# evidence for every published number; transcripts/ and prompts/ are regenerable
# copies of the same content and are excluded to keep the repository sane.
runs/*/transcripts/
runs/*/prompts/

# Screening runs nest one level deeper than the swept runs, so the patterns above
# did not cover them. Any run directory, at any depth, contributes results.jsonl
# as evidence and prompts/transcripts as regenerable bulk.
runs/**/prompts/
runs/**/transcripts/
